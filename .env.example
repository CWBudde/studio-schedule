# Configuration of `studio-schedule serve`. Copy to .env (git-ignored) and adjust;
# `just` recipes load it automatically, otherwise export the variables yourself.
# Every value can also be given as a flag; a flag on the command line wins over
# the environment. All values below are fictional examples.

# PostgreSQL connection, as a URL or a libpq key=value DSN. Leave empty to run
# with the in-memory store and demo data (changes are lost on exit). With a
# database, run `migrate up` first (and `seed` for demo data); `serve` refuses
# to start while migrations are pending. Flag: --database-url
DATABASE_URL=
# DATABASE_URL=postgres://studio:change-me@db.example.test:5432/studio?sslmode=require

# Listen address (host:port). Flag: --addr
HTTP_ADDR=:8080

# Public origin of the app, used to build absolute links (scheme://host[:port],
# no path). Optional. Flag: --base-url
BASE_URL=http://localhost:8080
