# Configuration of `studio-schedule serve`. Copy to .env (git-ignored) and adjust;
# `just` recipes load it automatically, otherwise export the variables yourself.
# The values that name a flag can also be given as one; a flag on the command
# line wins over the environment. All values below are fictional examples.

# PostgreSQL connection, as a URL or a libpq key=value DSN. Leave empty to run
# with the in-memory store and demo data (changes are lost on exit). With a
# database, run `migrate up` first (and `seed` for demo data); `serve` refuses
# to start while migrations are pending. Flag: --database-url
DATABASE_URL=
# DATABASE_URL=postgres://studio:change-me@db.example.test:5432/studio?sslmode=require

# Listen address (host:port). Flag: --addr
HTTP_ADDR=:8080

# Public origin of the app, used to build absolute links such as the ones in
# mails (scheme://host[:port], no path). Session cookies are Secure only with an
# https:// origin; leave it unset or http:// for local development only.
# Default: http://localhost:<port of HTTP_ADDR> (docker compose:
# http://localhost:<APP_PORT>). Flag: --base-url
BASE_URL=
# BASE_URL=https://schedule.example.test

# With an https:// BASE_URL, browsers get Strict-Transport-Security for a year,
# by default for every subdomain of the host too. Set false when other
# subdomains of the domain still serve plain http:// (environment only; see
# docs/operations.md, "Reverse proxy and TLS").
HSTS_INCLUDE_SUBDOMAINS=
# HSTS_INCLUDE_SUBDOMAINS=false

# Listen address (host:port) of a separate server for Prometheus metrics at
# /metrics. Empty: no metrics. Expose it to your monitoring only, never to the
# internet. Flag: --metrics-addr
METRICS_ADDR=
# METRICS_ADDR=127.0.0.1:9464

# Outgoing mail (environment only). Without SMTP_HOST, mails stay in the outbox
# and are never sent (docker compose sends them to its Mailpit instead, see
# below). SMTP_FROM is required with SMTP_HOST. SMTP_TLS is starttls (the
# default), tls (implicit TLS, port 465) or none (plain text, only for
# local mail catchers such as Mailpit). SMTP_PORT defaults to the port of the
# TLS mode (587 for starttls).
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_HOST=mail.example.test
# SMTP_USERNAME=schedule
# SMTP_PASSWORD=change-me
# SMTP_FROM=Studio Demo <schedule@example.test>

# Log output: LOG_FORMAT text (default) or json (the container image's
# default), LOG_LEVEL debug, info (default), warn or error. Flags: --log-format,
# --log-level
LOG_FORMAT=
LOG_LEVEL=

# ---------------------------------------------------------------- docker compose
# docker-compose.yml reads this file too. It builds DATABASE_URL from the
# POSTGRES_* values below (DATABASE_URL above is not used), and BASE_URL
# defaults to http://localhost:<APP_PORT>. While SMTP_HOST is empty, the app
# sends to the bundled Mailpit (port 1025, no TLS, whatever SMTP_PORT and
# SMTP_TLS say); with SMTP_HOST set, the SMTP_* values above apply as given.
# LOG_FORMAT defaults to json there. See docs/operations.md.
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=studio
# POSTGRES_DB=studio
# Host ports of the app and of Mailpit's web UI.
# APP_PORT=8080
# MAILPIT_PORT=8025
# A published image instead of a local build, e.g.
# STUDIO_SCHEDULE_IMAGE=ghcr.io/cwbudde/studio-schedule:edge
