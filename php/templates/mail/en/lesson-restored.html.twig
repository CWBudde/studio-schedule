{% extends 'layout.html.twig' %}
{% block content %}
<p>Hello{% if GivenName is not empty %} {{ GivenName }}{% endif %},</p>
<p>Good news: this lesson at {{ SchoolName }} takes place after all. Please note its time and place, which may have changed since the cancellation:</p>
<p><strong>{{ CourseType }}</strong><br>{{ StartsAt|mail_date(locale) }}, {{ StartsAt|mail_clock }}–{{ EndsAt|mail_clock }}<br>{{ Room }}, {{ Location }}<br>Booked for: {{ Participants|join(', ') }}</p>
<p>Your booking still stands.</p>
<p>Kind regards,<br>{{ SchoolName }}</p>
{%- endblock %}
