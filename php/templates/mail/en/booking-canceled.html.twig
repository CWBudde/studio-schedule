{% extends 'layout.html.twig' %}
{% block content %}
<p>Hello{% if GivenName is not empty %} {{ GivenName }}{% endif %},</p>
<p>{% if Lessons|length == 1 %}This booking at {{ SchoolName }} is canceled:{% else %}These bookings at {{ SchoolName }} are canceled:{% endif %}</p>
<p>Booked for: {{ Participant }}</p>
{%- for lesson in Lessons ~%}
<p><strong>{{ lesson.CourseType }}</strong><br>{{ lesson.StartsAt|mail_date(locale) }}, {{ lesson.StartsAt|mail_clock }}–{{ lesson.EndsAt|mail_clock }}<br>{{ lesson.Room }}, {{ lesson.Location }}{% if lesson.Late %}<br><strong>Late cancellation:</strong> after the cancellation deadline{% endif %}</p>
{%- endfor ~%}
<p>Kind regards,<br>{{ SchoolName }}</p>
{%- endblock %}
