{% extends 'layout.html.twig' %}
{% block content %}
<p>Hello{% if GivenName is not empty %} {{ GivenName }}{% endif %},</p>
<p>The email address of your account at {{ SchoolName }} was changed to <strong>{{ NewEmail }}</strong>. From now on, sign in with that address.</p>
<p>If this was not you, contact {{ SchoolName }} right away.</p>
<p>Kind regards,<br>{{ SchoolName }}</p>
{%- endblock %}
