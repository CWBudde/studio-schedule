{% extends 'layout.html.twig' %}
{% block content %}
<p>Hello{% if GivenName is not empty %} {{ GivenName }}{% endif %},</p>
<p>Please confirm the email address for your account at {{ SchoolName }}.</p>
<p><a href="{{ Link|mail_url }}" style="display:inline-block;padding:10px 20px;border-radius:6px;background-color:#18181b;color:#ffffff;text-decoration:none;">Confirm email address</a></p>
<p>If the button does not work, open this link in your browser:<br><a href="{{ Link|mail_url }}" style="color:#18181b;word-break:break-all;">{{ Link }}</a></p>
<p>The link is valid for {% if ExpiresHours == 1 %}1 hour{% else %}{{ ExpiresHours }} hours{% endif %}.</p>
<p>If you did not sign up, you can ignore this email.</p>
<p>Kind regards,<br>{{ SchoolName }}</p>
{%- endblock %}
