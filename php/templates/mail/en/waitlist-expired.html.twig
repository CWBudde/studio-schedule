{% extends 'layout.html.twig' %}
{% block content %}
<p>Hello{% if GivenName is not empty %} {{ GivenName }}{% endif %},</p>
<p>The place reserved for {{ Participant }} in this lesson at {{ SchoolName }} was not taken in time:</p>
<p><strong>{{ CourseType }}</strong><br>{{ StartsAt|mail_date(locale) }}, {{ StartsAt|mail_clock }}–{{ EndsAt|mail_clock }}<br>{{ Room }}, {{ Location }}</p>
{%- if StillWaiting ~%}
<p>{{ Participant }} stays on the waiting list, at its end, and is invited again when another place becomes free.</p>
{%- else ~%}
<p>{{ Participant }} is no longer on the waiting list for this lesson.</p>
{%- endif ~%}
<p>Kind regards,<br>{{ SchoolName }}</p>
{%- endblock %}
