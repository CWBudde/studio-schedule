{% extends 'layout.html.twig' %}
{% block content %}
<p>Hello{% if GivenName is not empty %} {{ GivenName }}{% endif %},</p>
<p>This lesson at {{ SchoolName }} has changed:</p>
<p><strong>{{ CourseType }}</strong><br>Now: <strong>{{ StartsAt|mail_date(locale) }}, {{ StartsAt|mail_clock }}–{{ EndsAt|mail_clock }}, {{ Room }}, {{ Location }}</strong><br>Before: <s>{{ PreviousStartsAt|mail_date(locale) }}, {{ PreviousStartsAt|mail_clock }}–{{ PreviousEndsAt|mail_clock }}, {{ PreviousRoom }}, {{ PreviousLocation }}</s><br>Booked for: {{ Participants|join(', ') }}</p>
<p>Your booking moves with the lesson. If the change does not suit you, contact {{ SchoolName }}.</p>
<p>Kind regards,<br>{{ SchoolName }}</p>
{%- endblock %}
