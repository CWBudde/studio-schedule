{% extends 'layout.html.twig' %}
{% block content %}
<p>Hello{% if GivenName is not empty %} {{ GivenName }}{% endif %},</p>
<p>A place has become free in a lesson at {{ SchoolName }} that {{ Participant }} is on the waiting list for:</p>
<p><strong>{{ CourseType }}</strong><br>{{ StartsAt|mail_date(locale) }}, {{ StartsAt|mail_clock }}–{{ EndsAt|mail_clock }}<br>{{ Room }}, {{ Location }}</p>
<p>The place is reserved for {{ Participant }} until {{ ExpiresAt|mail_date(locale) }}, {{ ExpiresAt|mail_clock }}.</p>
<p><a href="{{ Link|mail_url }}" style="display:inline-block;padding:10px 20px;border-radius:6px;background-color:#18181b;color:#ffffff;text-decoration:none;">Take the place</a></p>
<p>If the button does not work, open this link in your browser:<br><a href="{{ Link|mail_url }}" style="color:#18181b;word-break:break-all;">{{ Link }}</a></p>
<p>If the place is not taken by then, it goes to the next person on the waiting list.</p>
<p>Kind regards,<br>{{ SchoolName }}</p>
{%- endblock %}
