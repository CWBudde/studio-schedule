{% extends 'layout.html.twig' %}
{% block content %}
<p>Hello{% if GivenName is not empty %} {{ GivenName }}{% endif %},</p>
<p>{{ SchoolName }} has created an account for you. To choose your password and activate the account, open this link.</p>
<p><a href="{{ Link|mail_url }}" style="display:inline-block;padding:10px 20px;border-radius:6px;background-color:#18181b;color:#ffffff;text-decoration:none;">Choose a password</a></p>
<p>If the button does not work, open this link in your browser:<br><a href="{{ Link|mail_url }}" style="color:#18181b;word-break:break-all;">{{ Link }}</a></p>
<p>The link is valid for {% if ExpiresHours == 1 %}1 hour{% else %}{{ ExpiresHours }} hours{% endif %}. If it has expired, use “Forgot password?” on the sign-in page to get a new one.</p>
<p>If you did not expect this email, you can ignore it.</p>
<p>Kind regards,<br>{{ SchoolName }}</p>
{%- endblock %}
