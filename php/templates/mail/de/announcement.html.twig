{% extends 'layout.html.twig' %}
{% block content %}
<p>Hallo{% if GivenName is not empty %} {{ GivenName }}{% endif %},</p>
<p>{{ SchoolName }} hat eine Mitteilung{% if Participants is not empty %} für {{ Participants|join(', ') }}{% endif %}:</p>
<p><strong>{{ Title }}</strong></p>
<p style="margin:16px 0;padding:8px 16px;border-left:4px solid #d4d4d8;">{% for line in Message|split("\n") %}{% if not loop.first %}<br>{% endif %}{{ line }}{% endfor %}</p>
<p>Du findest sie auch in der App unter Mitteilungen auf der Startseite.</p>
<p>Viele Grüße<br>{{ SchoolName }}</p>
{%- endblock %}
