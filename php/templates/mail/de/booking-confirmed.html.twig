{% extends 'layout.html.twig' %}
{% block content %}
<p>Hallo{% if GivenName is not empty %} {{ GivenName }}{% endif %},</p>
<p>deine Buchung bei {{ SchoolName }} ist bestätigt:</p>
<p>Gebucht für: {{ Participant }}</p>
{%- for lesson in Lessons ~%}
<p><strong>{{ lesson.CourseType }}</strong><br>{{ lesson.StartsAt|mail_date(locale) }}, {{ lesson.StartsAt|mail_clock }}–{{ lesson.EndsAt|mail_clock }} Uhr<br>{{ lesson.Room }}, {{ lesson.Location }}</p>
{%- endfor ~%}
<p>{% if Guest %}Falls der Termin doch nicht passt, sag bitte rechtzeitig bei {{ SchoolName }} ab, damit jemand anderes den Platz bekommt.{% else %}Falls der Termin doch nicht passt, storniere die Buchung bitte rechtzeitig, damit jemand anderes den Platz bekommt.{% endif %}</p>
<p>Viele Grüße<br>{{ SchoolName }}</p>
{%- endblock %}
