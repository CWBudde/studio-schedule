{% extends 'layout.html.twig' %}
{% block content %}
<p>Hallo{% if GivenName is not empty %} {{ GivenName }}{% endif %},</p>
<p>die Anmeldung für diese Veranstaltung bei {{ SchoolName }} ist storniert:</p>
<p><strong>{{ Title }}</strong><br>Angemeldet: {{ Participant }}</p>
{%- if Refunded ~%}
<p>Die gezahlte Gebühr wird erstattet. Den Stornobeleg bekommst du mit einer eigenen E-Mail.</p>
{%- endif ~%}
<p>Viele Grüße<br>{{ SchoolName }}</p>
{%- endblock %}
