{
  "name": "cwbudde/studio-schedule",
  "description": "PHP backend for Studio Schedule",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.3",
    "php-64bit": "*",
    "ext-pdo": "*",
    "doctrine/dbal": "^4.4",
    "monolog/monolog": "^3.9",
    "psr/clock": "^1.0",
    "psr/log": "^3.0",
    "slim/psr7": "^1.8",
    "slim/slim": "^4.15",
    "symfony/dotenv": "^7.4",
    "symfony/uid": "^7.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.92",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "StudioSchedule\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StudioSchedule\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "format": "php-cs-fixer fix",
    "check-format": "php-cs-fixer check"
  }
}
